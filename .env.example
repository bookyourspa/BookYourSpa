# =============================================================================
# Book Your Spa — environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public origin of the app (used for links in emails/vouchers/SEO canonical URLs)
APP_URL=http://localhost:3000
# Port the Next.js server listens on
PORT=3000

# --- Database ----------------------------------------------------------------
# SQLite database file path (relative to repo root or absolute).
# Staging and production MUST use separate files/instances.
DATABASE_PATH=./data/bookyourspa.db

# --- Security ----------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-secret
# Optional admin bootstrap: when BOTH are set, the first request ensures this
# account exists as a super admin (created if missing; an existing account at
# this email is promoted only if it is not already super admin). Leave empty
# to disable. Recommended only for first-time setup on a fresh deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Display name for the bootstrapped admin (optional)
ADMIN_NAME=
# Optional supplier seed: creates this supplier account (with a pending
# business) on any instance whose database is missing it after a cold start.
SUPPLIER_EMAIL=
SUPPLIER_PASSWORD=
SUPPLIER_BUSINESS=
SUPPLIER_NAME=
# Set to 1 to seed the demo customer/supplier advertised on the login page
# (customer@demo.test / supplier@demo.test, password Demo123!) on fresh DBs.
# Do NOT enable on a production site with real data — the credentials are
# shown publicly on the login page.
SEED_DEMO=
# Session lifetime in hours
SESSION_TTL_HOURS=168
# Booking hold (temporary reservation lock) duration in minutes
BOOKING_HOLD_MINUTES=10

# --- Payments ----------------------------------------------------------------
# Payment provider key (modular: "sandbox" for local/QA, later "stripe" etc.)
PAYMENT_PROVIDER=sandbox
# Platform commission default (percent). Overridable in admin settings.
DEFAULT_COMMISSION_RATE=10

# --- Notifications -----------------------------------------------------------
# Email transport: "log" writes emails to DB outbox (default), "smtp" sends real mail
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Book Your Spa <no-reply@bookyourspa.net>"

# WhatsApp provider (leave empty to log messages to DB outbox instead of sending)
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- SEO / Analytics ---------------------------------------------------------
SITE_NAME=Book Your Spa
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
