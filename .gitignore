.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# testing
/coverage

# uploads (user-generated images stored outside git)
/public/uploads
!/public/uploads/.gitkeep
